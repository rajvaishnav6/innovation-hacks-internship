{
  "info": {
    "name": "Innovation Hacks - Users, Projects & Tasks API",
    "description": "Task 2 REST API for the Innovation Hacks Full Stack Development Internship.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get All Users", "request": { "method": "GET", "url": "{{baseUrl}}/users" } },
        { "name": "Get User By Id", "request": { "method": "GET", "url": "{{baseUrl}}/users/u1" } },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Priya Verma\",\n  \"email\": \"priya@example.com\",\n  \"role\": \"Frontend Intern\"\n}" },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"Senior Intern\"\n}" },
            "url": "{{baseUrl}}/users/u1"
          }
        },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/u1" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        { "name": "Get All Projects", "request": { "method": "GET", "url": "{{baseUrl}}/projects" } },
        { "name": "Get Projects Filtered By Status", "request": { "method": "GET", "url": "{{baseUrl}}/projects?status=In%20Progress" } },
        { "name": "Get Project By Id", "request": { "method": "GET", "url": "{{baseUrl}}/projects/p1" } },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Landing Page\",\n  \"description\": \"A fresh landing page for the product launch.\",\n  \"status\": \"Planning\",\n  \"dueDate\": \"2026-10-15\"\n}" },
            "url": "{{baseUrl}}/projects"
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\"\n}" },
            "url": "{{baseUrl}}/projects/p1"
          }
        },
        { "name": "Delete Project", "request": { "method": "DELETE", "url": "{{baseUrl}}/projects/p1" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        { "name": "Get All Tasks", "request": { "method": "GET", "url": "{{baseUrl}}/tasks" } },
        { "name": "Get Tasks Filtered By Project", "request": { "method": "GET", "url": "{{baseUrl}}/tasks?projectId=p1" } },
        { "name": "Get Task By Id", "request": { "method": "GET", "url": "{{baseUrl}}/tasks/t1" } },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Write onboarding docs\",\n  \"projectId\": \"p1\",\n  \"priority\": \"Medium\",\n  \"dueDate\": \"2026-09-20\"\n}" },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"High\"\n}" },
            "url": "{{baseUrl}}/tasks/t1"
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\"\n}" },
            "url": "{{baseUrl}}/tasks/t1/status"
          }
        },
        { "name": "Delete Task", "request": { "method": "DELETE", "url": "{{baseUrl}}/tasks/t1" } }
      ]
    }
  ]
}
